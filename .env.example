# Copy to .env.local for local development.
# Add the same variables in Vercel: Project Settings → Environment Variables

# Lauren's email — shown on the contact page and receives form submissions
CONTACT_EMAIL=hello@laurensnichols.com

# Free form delivery via https://web3forms.com
# 1. Sign up and add CONTACT_EMAIL as the destination inbox
# 2. Copy your access key here
WEB3FORMS_ACCESS_KEY=your-access-key-here

# NEXT_PUBLIC_SITE_URL=https://your-domain.com
